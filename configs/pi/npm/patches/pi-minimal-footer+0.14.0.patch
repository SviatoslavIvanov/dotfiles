@@ -0,0 +1,65 @@
+import type { AgentSession, ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { isApiBilled } from "./session-cost.js";
+
+// Local integration with pi-subagents-lite 1.18.0. Snapshots are cumulative,
+// keyed by child session, persisted outside model context, and never summed twice.
+export const CHILD_COST_ENTRY = "sv-subagent-cost-v1";
+export const CHILD_COST_CHANNEL = "sv:subagent-cost-session-v1";
+
+export function trackSubagentCosts(
+  pi: ExtensionAPI,
+  getContext: () => ExtensionContext | undefined,
+  refresh: () => void,
+): () => void {
+  const tracked = new Map<string, { flush: () => void; stop: () => void }>();
+  pi.events.on(CHILD_COST_CHANNEL, (value: unknown) => {
+    const data = value as { parentSessionId?: string; session?: AgentSession } | undefined;
+    const child = data?.session;
+    const ctx = getContext();
+    if (!child || !ctx || data?.parentSessionId !== ctx.sessionManager.getSessionId()) return;
+    if (tracked.has(child.sessionId)) return;
+    const parentSessionId = data.parentSessionId;
+    let stopped = false;
+    let queued = false;
+    let lastCost = 0;
+    let apiCost = 0;
+    const flush = () => {
+      queued = false;
+      if (stopped || getContext()?.sessionManager.getSessionId() !== parentSessionId) return;
+      const cost = child.getSessionStats().cost;
+      if (!Number.isFinite(cost) || cost <= lastCost) return;
+      const nextApiCost = apiCost + (isApiBilled(ctx, child.model) ? cost - lastCost : 0);
+      try {
+        pi.appendEntry(CHILD_COST_ENTRY, { sessionId: child.sessionId, cost, apiCost: nextApiCost });
+        lastCost = cost;
+        apiCost = nextApiCost;
+        refresh();
+      } catch (error) {
+        console.error("[pi-minimal-footer] Could not save subagent cost:", error);
+      }
+    };
+    const unsubscribe = child.subscribe((event) => {
+      if (!["message_end", "compaction_end", "agent_end"].includes(event.type) || queued) return;
+      queued = true;
+      // Pi notifies public listeners BEFORE appending a finished message.
+      queueMicrotask(flush);
+    });
+    tracked.set(child.sessionId, {
+      flush,
+      stop: () => { stopped = true; unsubscribe(); },
+    });
+    flush();
+  });
+  pi.events.on("subagents:child:disposed", (value: unknown) => {
+    const id = (value as { sessionId?: string } | undefined)?.sessionId;
+    if (!id) return;
+    const trackedChild = tracked.get(id);
+    trackedChild?.flush();
+    trackedChild?.stop();
+    tracked.delete(id);
+  });
+  return () => {
+    for (const child of tracked.values()) { child.flush(); child.stop(); }
+    tracked.clear();
+  };
+}
