+/** Price each recorded provider/model, never the whole history as the current model. */
+export function sessionCost(ctx: ExtensionContext): string | null {
+  const parentApi = isApiBilled(ctx, ctx.model);
+  const models = new Map<string, Model<any> | undefined>();
+  const children = new Map<string, { cost: number; apiCost?: number }>();
   let total = 0;
   for (const entry of ctx.sessionManager.getEntries()) {
+    let model = entry.parentId ? models.get(entry.parentId) : undefined;
+    if (entry.type === "model_change") {
+      model = ctx.modelRegistry.find(entry.provider, entry.modelId);
+    } else if (entry.type === "usage") {
+      model = ctx.modelRegistry.find(entry.provider, entry.model);
+    } else if (entry.type === "message" && entry.message.role === "assistant") {
+      model = ctx.modelRegistry.find(entry.message.provider, entry.message.model);
+    }
+    models.set(entry.id, model);
+    if (entry.type === "custom" && entry.customType === "sv-subagent-cost-v1") {
+      const data = entry.data as { sessionId?: string; cost?: number; apiCost?: number } | undefined;
+      if (typeof data?.sessionId === "string" && typeof data.cost === "number" && Number.isFinite(data.cost) && data.cost >= 0) {
+        const previous = children.get(data.sessionId);
+        const snapshot = { cost: Math.max(previous?.cost ?? 0, data.cost), apiCost: previous?.apiCost };
+        if (typeof data.apiCost === "number" && Number.isFinite(data.apiCost) && data.apiCost >= 0) {
+          snapshot.apiCost = Math.max(snapshot.apiCost ?? 0, Math.min(data.apiCost, data.cost));
+        }
+        children.set(data.sessionId, snapshot);
+      }
+    }
     const usage = entry.type === "message"
       ? (entry.message.role === "assistant" || entry.message.role === "toolResult" ? entry.message.usage : undefined)
       : (entry.type === "usage" || entry.type === "compaction" || entry.type === "branch_summary" ? entry.usage : undefined);
     const cost = usage?.cost.total;
-    if (cost !== undefined && Number.isFinite(cost) && cost >= 0) total += cost;
+    if (isApiBilled(ctx, model) && cost !== undefined && Number.isFinite(cost) && cost >= 0) total += cost;
   }
-  return `~$${total.toFixed(3)}`;
+  // Old child snapshots have no billing split: retain their previous behavior only for API parents.
+  for (const child of children.values()) total += child.apiCost ?? (parentApi ? child.cost : 0);
+  if (!parentApi && total === 0) return null;
+  return `${parentApi ? "" : "API "}${total > 0 && total < 0.01 ? "<$0.01" : `~$${total.toFixed(2)}`}`;
